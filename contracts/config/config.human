# ======================================================
# CONTRATO HUMANO — HORMIGASAIS LBH
# Archivo: config.human
# Ubicación: /contracts/config/config.human
# Autoridad: HUMANO
# ======================================================

[HUMAN]
id = "human_root"
authority = true
override = true

[SWARM]
name = "HormigasAIS"
mode = "cooperative"
telemetry_topic = "hormigasais/swarm/telemetry"

[PERMISSION:LBH_ASSIST]
enabled = true
description = "Permite ayuda entre agentes del mismo enjambre bajo control humano"

constraints = [
  "same_swarm_only",
  "no_control_transfer",
  "audit_required",
  "human_override_allowed"
]

allowed_roles = [
  "manager",
  "worker"
]

forbidden_actions = [
  "delegate_control",
  "modify_human_contract",
  "escalate_privileges",
  "spawn_agents"
]

[AUDIT]
log_all = true
log_level = "full"
observer = "human"

[ENFORCEMENT]
violation_action = "deny_and_log"
silent_execution = false

# ======================================================
# FIN DEL CONTRATO HUMANO
# ======================================================
